{
  "name": "huabu",
  "productName": "Huabu",
  "version": "0.1.0",
  "description": "画布即工作区的桌面 Agent 应用：无限画布管理素材卡片，对话坞承载多个 Pi Agent 会话",
  "author": {
    "name": "acefun29",
    "email": "145213716+acefun29@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acefun29/huabu-agent.git"
  },
  "keywords": [
    "electron",
    "agent",
    "canvas",
    "workspace",
    "ai",
    "desktop-app"
  ],
  "main": "./out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "selfcheck": "electron scripts/ipc-selfcheck.cjs",
    "catalog:check": "node scripts/catalog-check.mjs",
    "asset-path:check": "node scripts/asset-path-check.mjs",
    "tags-index:check": "node scripts/tags-index-check.mjs",
    "context-digest:check": "node scripts/context-digest-check.mjs",
    "chat-events:check": "node scripts/chat-events-check.mjs",
    "context-breakdown:check": "node scripts/context-breakdown-check.mjs",
    "session-history:check": "node scripts/session-history-check.mjs",
    "session-fork:check": "node scripts/session-fork-check.mjs",
    "probe:media-assembly": "electron scripts/t12-media-assembly-probe.cjs",
    "probe:asset-transfer": "electron scripts/asset-transfer-probe.cjs",
    "probe:read-media": "electron scripts/t7-read-media-probe.cjs",
    "probe:video-frames": "electron scripts/t13-video-frames-probe.cjs",
    "probe:history-thumbs": "electron scripts/history-thumbs-probe.cjs",
    "chat-catalog:check": "node scripts/chat-catalog-check.mjs",
    "chat-catalog:wire": "node scripts/t4-wire-capture.mjs",
    "test:scenario": "node scripts/full-scenario.mjs",
    "test:full": "node scripts/full-scenario.mjs --with-e2e",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "bench": "node scripts/perf-bench.mjs",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "dist": "electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller",
      "ffmpeg-static"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.46.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "ffmpeg-static": "^5.3.0",
    "typebox": "^1.3.7"
  }
}
