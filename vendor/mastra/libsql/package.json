{
  "name": "@mastra/libsql",
  "version": "1.29.0",
  "description": "Libsql provider for Mastra - includes both vector and db storage capabilities",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "tsdown --watch --silent --config tsdown.config.ts"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@libsql/client": "^0.18.0"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.46.0",
    "@internal/core": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@types/node": "22.19.15",
    "tsdown": "0.23.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.76.0-0 <2.0.0-0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "stores/libsql"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
